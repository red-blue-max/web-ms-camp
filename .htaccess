# Кодировка
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Проверка сертификата Let's Encrypt должна проходить по http — её не трогаем
  RewriteRule ^\.well-known/acme-challenge/ - [L]

  # www.ms-camp.ru → ms-camp.ru, протокол сохраняем.
  # Переадресацию http → https включает ХОСТИНГ (в настройках сайта Timeweb),
  # здесь её делать нельзя: SSL терминируется на nginx, Apache видит обычный http,
  # и правило зацикливается (ERR_TOO_MANY_REDIRECTS).
  RewriteCond %{HTTP_HOST} ^www\.ms-camp\.ru$ [NC]
  RewriteCond %{HTTPS} =on [OR]
  RewriteCond %{HTTP:X-Forwarded-Proto} =https
  RewriteRule ^(.*)$ https://ms-camp.ru/$1 [R=301,L]

  RewriteCond %{HTTP_HOST} ^www\.ms-camp\.ru$ [NC]
  RewriteRule ^(.*)$ http://ms-camp.ru/$1 [R=301,L]
</IfModule>

# Технический домен не должен попадать в поиск как копия сайта
<IfModule mod_headers.c>
  SetEnvIf Host ^(www\.)?ms-camp\.ru$ MAINHOST=1
  Header set X-Robots-Tag "noindex, nofollow" env=!MAINHOST
</IfModule>

# Кэш статики: картинки, стили и скрипты меняются вместе с ?v=N в index.html
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg               "access plus 1 year"
  ExpiresByType image/png                "access plus 1 year"
  ExpiresByType image/webp               "access plus 1 year"
  ExpiresByType image/svg+xml            "access plus 1 year"
  ExpiresByType image/x-icon             "access plus 1 year"
  ExpiresByType text/css                 "access plus 1 month"
  ExpiresByType application/javascript   "access plus 1 month"
  ExpiresByType text/html                "access plus 0 seconds"
</IfModule>

# Сжатие
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

# Служебные файлы наружу не отдаём
<FilesMatch "\.(md|py|docx)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</FilesMatch>
