# Кодировка
AddDefaultCharset UTF-8

# Единственный адрес сайта: https:// без www.
# Правила срабатывают ТОЛЬКО для ms-camp.ru, чтобы сайт можно было проверять
# на техническом домене Timeweb (*.tw1.ru) до переноса домена.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # http://ms-camp.ru → https://ms-camp.ru
  RewriteCond %{HTTP_HOST} ^(www\.)?ms-camp\.ru$ [NC]
  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://ms-camp.ru/$1 [R=301,L]

  # www.ms-camp.ru → ms-camp.ru
  RewriteCond %{HTTP_HOST} ^www\.ms-camp\.ru$ [NC]
  RewriteRule ^(.*)$ https://ms-camp.ru/$1 [R=301,L]
</IfModule>

# Технический домен не должен попадать в поиск как копия сайта
<IfModule mod_headers.c>
  SetEnvIf Host ^(www\.)?ms-camp\.ru$ MAINHOST=1
  Header set X-Robots-Tag "noindex, nofollow" env=!MAINHOST
</IfModule>

# Кэш статики: картинки, стили и скрипты меняются вместе с ?v=N в index.html
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg               "access plus 1 year"
  ExpiresByType image/png                "access plus 1 year"
  ExpiresByType image/webp               "access plus 1 year"
  ExpiresByType image/svg+xml            "access plus 1 year"
  ExpiresByType image/x-icon             "access plus 1 year"
  ExpiresByType text/css                 "access plus 1 month"
  ExpiresByType application/javascript   "access plus 1 month"
  ExpiresByType text/html                "access plus 0 seconds"
</IfModule>

# Сжатие
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

# Служебные файлы наружу не отдаём
<FilesMatch "\.(md|py|docx)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</FilesMatch>
